{
  "name": "@chepelcr/tsuru-storefront-sdk",
  "version": "2.2.0",
  "description": "Shared storefront data layer for Tsuru templates: /config.json mode resolution, guest SigV4 signing (W7 identity pool), the public-API client (demo vs live org URLs), and shared DTO contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-test-module-mocks --test tests/client.products.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tsuru",
    "storefront",
    "public-api",
    "sigv4"
  ],
  "author": "jcampos",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chepelcr/tsuru-storefront-sdk.git"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "aws-amplify": "^6.0.0"
  },
  "devDependencies": {
    "aws-amplify": "^6.15.5",
    "typescript": "^5.6.0"
  }
}
